<Window x:Class="MboxViewer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:MboxViewer.Desktop.Models"
        mc:Ignorable="d"
        Title="MboxViewer"
        Width="1480"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="28">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            Margin="0,0,14,0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="16">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="M" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="MboxViewer" />
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding MailboxTitle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,10,0"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Limpiar filtros"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Command="{Binding OpenMailboxCommand}"
                            Content="Abrir MBOX"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <Border Height="48"
                        Margin="28,0"
                        Background="{StaticResource InputBrush}"
                        CornerRadius="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="BUSCAR" />
                        <TextBox Grid.Column="1"
                                 Margin="0,0,18,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="{StaticResource TextBrush}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,16,0"
                    Padding="18"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Navegacion" />

                    <ListBox Grid.Row="1"
                             Margin="0,14,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NavigationItem}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="24"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource InputBrush}"
                                            CornerRadius="8">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding Icon}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <Border Grid.Column="2"
                                            Padding="10,4"
                                            Background="{StaticResource ChipBrush}"
                                            CornerRadius="12">
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding Count}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2"
                                Margin="0,16,0,0">
                        <CheckBox Content="Solo no leidos"
                                  IsChecked="{Binding ShowUnreadOnly}" />
                        <CheckBox Margin="0,10,0,0"
                                  Content="Solo destacados"
                                  IsChecked="{Binding ShowStarredOnly}" />
                        <Border Margin="0,18,0,0"
                                Padding="14"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="18">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Estado: " />
                                <Run Foreground="{StaticResource MutedBrush}"
                                     Text="{Binding StatusText}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,0,16,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="18"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Mensajes" />
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding StatusText}" />
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding FilteredMessages}"
                             SelectedItem="{Binding SelectedMessage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:EmailMessage}">
                                <Border Margin="12,8"
                                        Padding="14"
                                        Background="{StaticResource ListItemBrush}"
                                        CornerRadius="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Top"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding StatusGlyph}" />
                                        <StackPanel Grid.Column="1">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                           FontSize="15"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding DisplaySender}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Text="{Binding DisplayDate}" />
                                            </DockPanel>
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="14"
                                                       Text="{Binding Subject}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding Preview}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding IsStarred, Converter={StaticResource StarConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="28">
                <Grid>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="28"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedMessage.Subject}" />
                            <DockPanel Margin="0,14,0,0">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedMessage.DisplaySender}" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding SelectedMessage.FullDate}" />
                                </StackPanel>
                                <WrapPanel DockPanel.Dock="Right"
                                           HorizontalAlignment="Right">
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding ToggleStarCommand}"
                                            Content="Destacar"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding ToggleReadStateCommand}"
                                            Content="Leido / no leido"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding ArchiveCommand}"
                                            Content="Archivar"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Command="{Binding DeleteCommand}"
                                            Content="Papelera"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>

                        <ItemsControl Grid.Row="1"
                                      Margin="0,18,0,0"
                                      ItemsSource="{Binding SelectedMessage.Labels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,10"
                                            Padding="12,6"
                                            Background="{StaticResource ChipBrush}"
                                            CornerRadius="999">
                                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TabControl Grid.Row="2"
                                    Margin="0,18,0,0">
                            <TabItem Header="Mensaje">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Margin="8"
                                               FontSize="14"
                                               LineHeight="24"
                                               Text="{Binding SelectedMessage.PlainTextBody}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Encabezados">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox Margin="8"
                                             Background="{StaticResource InputBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             IsReadOnly="True"
                                             Text="{Binding SelectedMessage.HeadersText}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True" />
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Border Width="420"
                                Padding="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="26">
                            <StackPanel>
                                <Border Width="72"
                                        Height="72"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="24">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="M" />
                                </Border>
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Text="Sin mensaje seleccionado" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Center"
                                           Text="Abre un archivo MBOX y selecciona un correo para ver su contenido completo." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

